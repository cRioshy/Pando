# PandorickKi environment example

# Paths
PANDORICKKI_CRYPTO_PATH=../external/VIP-Trade-Engine-4.5-Monitor
PANDORICKKI_STOCK_PATH=../external/pandorick_stock_bot
PANDORICKKI_DATA_DIR=data

# Runtime
PANDORICKKI_CYCLE_INTERVAL=60
PANDORICKKI_CONTROL_CENTER_ENABLED=1
PANDORICKKI_CONTROL_REFRESH=1
PANDORICKKI_EVENT_BUS_MAX_HISTORY=2000
PANDORICKKI_STORAGE_SCAN_INTERVAL=60
PANDORICKKI_STORAGE_SCAN_TIMEOUT=30
PANDORICKKI_STORAGE_LARGE_FILE_THRESHOLD_BYTES=52428800
PANDORICKKI_STORAGE_SCAN_BYTE_BUDGET=262144
PANDORICKKI_STOP_TIMEOUT=2
PANDORICKKI_JSONL_LEDGER_ROTATION_BYTES=134217728

# Crypto
PANDORICKKI_LIVE_CRYPTO=0
PANDORICKKI_CRYPTO_LIVE_PRICE_DISPLAY=0
PANDORICKKI_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT
PANDORICKKI_CRYPTO_TIMEFRAME=15m
PANDORICKKI_CRYPTO_CANDLE_LIMIT=240

# Stocks
PANDORICKKI_STOCK_TEST_MODE=1
PANDORICKKI_STOCK_LIVE_PRICE_DISPLAY=0

# Commodities
PANDORICKKI_COMMODITIES_ENABLED=0
PANDORICKKI_COMMODITY_SYMBOLS=GC=F,SI=F,CL=F,BZ=F

# Telegram
PANDORICKKI_TELEGRAM_ENABLED=0
PANDORICKKI_TELEGRAM_DRY_RUN=1
PANDORICKKI_TELEGRAM_BOT_TOKEN=
PANDORICKKI_TELEGRAM_CHAT_ID=
PANDORICKKI_TELEGRAM_LOG_FILE=data\telegram_dry_run.jsonl
