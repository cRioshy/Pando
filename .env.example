# PandorickKi environment example

# Paths
PANDORICKKI_CRYPTO_PATH=../external/VIP-Trade-Engine-4.5-Monitor
PANDORICKKI_STOCK_PATH=../external/pandorick_stock_bot
PANDORICKKI_DATA_DIR=data

# Runtime
PANDORICKKI_CYCLE_INTERVAL=60
PANDORICKKI_CONTROL_CENTER_ENABLED=1
PANDORICKKI_CONTROL_REFRESH=1
PANDORICKKI_EVENT_BUS_MAX_HISTORY=2000
PANDORICKKI_STORAGE_SCAN_INTERVAL=60
PANDORICKKI_STORAGE_SCAN_TIMEOUT=30
PANDORICKKI_STORAGE_LARGE_FILE_THRESHOLD_BYTES=52428800
PANDORICKKI_STORAGE_SCAN_BYTE_BUDGET=262144
PANDORICKKI_STOP_TIMEOUT=2
PANDORICKKI_JSONL_LEDGER_ROTATION_BYTES=134217728

# Bounded service-error journal (compact, secret-filtered projections only)
PANDORICKKI_SERVICE_ERROR_JOURNAL_ENABLED=1
PANDORICKKI_SERVICE_ERROR_JOURNAL_FILE=data\service_errors.jsonl
PANDORICKKI_SERVICE_ERROR_SUMMARY_FILE=data\service_error_summary.json
PANDORICKKI_SERVICE_ERROR_ROTATION_BYTES=5242880
PANDORICKKI_SERVICE_ERROR_MAX_ARCHIVES=4
PANDORICKKI_SERVICE_ERROR_MAX_SUMMARY_ENTRIES=500

# Decision Gate audit observer (disabled; both thresholds are required when enabled)
PANDORICKKI_DECISION_GATE_OBSERVER_ENABLED=0
PANDORICKKI_DECISION_GATE_AUDIT_FILE=data\decision_gate_audit.jsonl
PANDORICKKI_DECISION_GATE_AUDIT_ROTATION_BYTES=5242880
PANDORICKKI_DECISION_GATE_AUDIT_MAX_ARCHIVES=4
PANDORICKKI_DECISION_GATE_MINIMUM_PROBABILITY=
PANDORICKKI_DECISION_GATE_MINIMUM_CONFIDENCE=
PANDORICKKI_DECISION_GATE_CONFIDENCE_TOLERANCE=0

# Crypto
PANDORICKKI_LIVE_CRYPTO=0
PANDORICKKI_CRYPTO_LIVE_PRICE_DISPLAY=0
PANDORICKKI_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT
PANDORICKKI_CRYPTO_TIMEFRAME=15m
PANDORICKKI_CRYPTO_CANDLE_LIMIT=240

# Stocks
PANDORICKKI_STOCK_TEST_MODE=1
PANDORICKKI_STOCK_LIVE_PRICE_DISPLAY=0
PANDORICKKI_STOCK_DATA_OBSERVER_ENABLED=0
PANDORICKKI_STOCK_DAILY_CANDLE_LIMIT=260
PANDORICKKI_STOCK_CANDLE_CACHE_TTL_SECONDS=900
PANDORICKKI_STOCK_DATA_MINIMUM_CANDLES=200
PANDORICKKI_STOCK_DATA_FULL_WARMUP_CANDLES=200
PANDORICKKI_STOCK_DATA_MAXIMUM_CANDLE_AGE_SECONDS=345600
PANDORICKKI_STOCK_DATA_MAXIMUM_QUOTE_AGE_SECONDS=900
PANDORICKKI_STOCK_DATA_MAXIMUM_FUTURE_SKEW_SECONDS=30
PANDORICKKI_STOCK_DATA_MAXIMUM_ENTRY_DEVIATION_PERCENT=0.5
PANDORICKKI_STOCK_SHADOW_LONG_BULLISH_SCORE=60
PANDORICKKI_STOCK_SHADOW_SHORT_BULLISH_SCORE=40
PANDORICKKI_STOCK_SHADOW_RISK_ATR_MULTIPLIER=1
PANDORICKKI_STOCK_SHADOW_RISK_MINIMUM_DISTANCE_PERCENT=0.5
PANDORICKKI_STOCK_SHADOW_RISK_TARGET_1_MULTIPLE=1
PANDORICKKI_STOCK_SHADOW_RISK_TARGET_2_MULTIPLE=2
PANDORICKKI_STOCK_SHADOW_RISK_TARGET_3_MULTIPLE=3
PANDORICKKI_STOCK_SHADOW_RISK_PRICE_DECIMALS=4

# Stock Live-Shadow verification (observer-only; disabled until an explicit run)
PANDORICKKI_STOCK_SHADOW_VERIFICATION_ENABLED=0
# NORMAL creates and completes cases; DRAIN only completes/links existing cases; STOPPED subscribes to nothing.
PANDORICKKI_STOCK_SHADOW_VERIFICATION_MODE=NORMAL
PANDORICKKI_STOCK_SHADOW_VERIFICATION_FILE=data\stock_shadow_verification.jsonl
PANDORICKKI_STOCK_SHADOW_VERIFICATION_ROTATION_BYTES=20971520
PANDORICKKI_STOCK_SHADOW_VERIFICATION_MAX_ARCHIVES=8
PANDORICKKI_STOCK_SHADOW_VERIFICATION_HORIZON_SECONDS=86400
PANDORICKKI_STOCK_SHADOW_VERIFICATION_NEUTRAL_BAND_PERCENT=0.05

# Market Regime v1 (observer-only; no decision, Telegram or order effect)
PANDORICKKI_MARKET_REGIME_OBSERVER_ENABLED=0
PANDORICKKI_MARKET_REGIME_FILE=data\market_regime.jsonl
PANDORICKKI_MARKET_REGIME_ROTATION_BYTES=20971520
PANDORICKKI_MARKET_REGIME_MAX_ARCHIVES=8
PANDORICKKI_MARKET_REGIME_QUEUE_CAPACITY=512
PANDORICKKI_MARKET_REGIME_BATCH_SIZE=32
PANDORICKKI_MARKET_REGIME_FLUSH_INTERVAL=0.25

# Commodities
PANDORICKKI_COMMODITIES_ENABLED=0
PANDORICKKI_COMMODITY_SYMBOLS=GC=F,SI=F,CL=F,BZ=F

# Telegram
PANDORICKKI_TELEGRAM_ENABLED=0
PANDORICKKI_TELEGRAM_DRY_RUN=1
PANDORICKKI_TELEGRAM_BOT_TOKEN=
PANDORICKKI_TELEGRAM_CHAT_ID=
PANDORICKKI_TELEGRAM_LOG_FILE=data\telegram_dry_run.jsonl
